# 任意 OpenAI-compatible 接口都行
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# Agent 只能在这个目录里干活
WORKSPACE_DIR=./agent_workspace
MAX_TOOL_ROUNDS=12
# 会话数据库位置（v0.3 SQLite，默认 ./data/agent.db；容器里是 /app/data）
DATA_DIR=./data
# 每次请求最多带回的最近轮数（默认 20，改大更贵更慢）
HISTORY_ROUNDS=20
# 长期记忆每次注入的字符上限（默认 2000，超了只取前部）
MEMORY_MAX_CHARS=2000
# 上下文预算（v0.6，默认 8000 token，只算 history + 长期记忆；
# 超预算从最旧 history 整轮丢弃，system / 记忆 / 最新一轮永不丢）
CONTEXT_TOKEN_BUDGET=8000
# 小 RAG（v0.7）：文档检索走 embedding 接口，与聊天共用 LLM_API_KEY / LLM_BASE_URL
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
# 检索语料目录（留空 = WORKSPACE_DIR/docs，只收 .md、排除 MEMORY.md）
RAG_DOCS_DIR=
# 每次检索返回的段落数与最低余弦相似度（低于阈值老实返回未找到）。
# 阈值默认 0.4：2026-10-29 真机校准（无关约 0.34–0.35、相关 0.52/0.60），
# 样本很小、是经验值，评测集任务 4/5 是它的回归用例。
RAG_TOP_K=3
RAG_MIN_SCORE=0.4
# 审批卡无人确认的超时秒数（默认 300，超时按拒绝处理）
APPROVAL_TIMEOUT_SECONDS=300
# 访问口令（强烈建议设置；设置后网页会弹窗要求输入，留空=不鉴权、只能内网用）
ACCESS_TOKEN=change-me-to-a-long-random-string
# 可选：网页版 VS Code (code-server) 的登录密码
CODE_SERVER_PASSWORD=change-me-too
